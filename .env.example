# Copia este archivo a .env y rellena los valores. .env NO se commitea nunca.

# --- OpenAI ---
OPENAI_API_KEY=

# --- Jira / Atlassian (OAuth) ---
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# --- Base de datos (Docker Compose local) ---
DATABASE_URL=postgres://youautoqa:youautoqa@localhost:5432/youautoqa

# --- Límites del agente (RNF-1, RNF-2): configurables, nunca hardcodeados ---
MAX_ATTEMPTS=5
EXECUTION_TIMEOUT_SECONDS=120

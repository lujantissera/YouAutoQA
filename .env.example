# Copia este archivo a .env y rellena los valores. .env NO se commitea nunca.

# --- OpenAI ---
OPENAI_API_KEY=
# Modelos por tarea (D-37). Cambiarlos al medir coste real (RNF-5); no van en el código.
OPENAI_MODEL_GENERATE=gpt-6.1-sol
OPENAI_MODEL_TRIAGE=gpt-6-luna

# --- Jira / Atlassian (OAuth) ---
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# --- Base de datos (Docker Compose local) ---
DATABASE_URL=postgres://youautoqa:youautoqa@localhost:5432/youautoqa

# --- Aplicación bajo test (RNF-6). Para las pruebas del paso 4: una web pública de práctica ---
AUT_BASE_URL=https://www.saucedemo.com

# --- Límites del agente (RNF-1, RNF-2): configurables, nunca hardcodeados ---
MAX_ATTEMPTS=5
EXECUTION_TIMEOUT_SECONDS=120
MAX_TOKENS=50000
# Máximo de preguntas que el agente puede hacer al usuario por job (D-42)
MAX_CLARIFICATIONS=3
# Comprobar con el modelo barato que la US tenga información suficiente antes de generar (D-40)
STORY_CHECK=true


# --- Runner de Robot Framework (Docker) ---
# Imagen con versión fija (D-35): obligatoria, nunca `latest`.
RF_RUNNER_IMAGE=marketsquare/robotframework-browser:20.6.0
# Límites de cada ejecución (opcionales; por defecto 1g, 1 y 256)
RF_RUNNER_MEMORY=1g
RF_RUNNER_CPUS=1
RF_RUNNER_PIDS_LIMIT=256